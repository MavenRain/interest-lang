def members : Nat := 3
-- Arrow-Debreu regime (host README, The domain).  The constitution factors through
-- `orbit`, so the program writes its aggregation and uses cast and amend.
-- `H` is plurality by `natLt`: a strict maximum wins, and a tie gives
-- `frozen`.  `c` is the count triple (open, restricted, frozen).
def plural : T3 -> Charter := fun (c : T3) =>
  case natLt c.1.0 c.0 with
  | 0 (u : prod ()) =>
    (case natLt c.0 c.1.0 with
     | 0 (v : prod ()) => frozen
     | 1 (v : prod ()) =>
       (case natLt c.1.1 c.1.0 with
        | 0 (w : prod ()) => frozen
        | 1 (w : prod ()) => restricted))
  | 1 (u : prod ()) =>
    (case natLt c.1.1 c.0 with
     | 0 (v : prod ()) => frozen
     | 1 (v : prod ()) => open)
def H : Tally -> Charter := fun (t : Tally) => plural (counts t)

def F : ChoiceRule := fun (x : Config) => H (orbit x)
def agg : Aggregation F := mkAgg F H (fun (x : Config) => reflDec (H (orbit x)))

-- cast: two configurations in one orbit give one verdict.
def xs : Ballots := bcons open (bcons restricted (bcons open bnil))
def x : Config := mkConfig xs (reflNat 3)
def ys : Ballots := bcons restricted (bcons open (bcons open bnil))
def y : Config := mkConfig ys (reflNat 3)
def castX : EqDec (F x) (gov F agg x) := cast F agg x
def verdictX : EqDec (gov F agg x) open := reflDec open
def sameOrbit : EqTally (orbit x) (orbit y) := reflTally (orbit x)
def castXY : EqDec (gov F agg x) (gov F agg y) := castOrbit F agg x y sameOrbit

-- amend at the canonical amendment rule.
def G : ChoiceRule := amend canonical F agg
def homX : EqDec (G x) (gov F agg x) := homAmend F agg x
def aggGov : Aggregation (gov F agg) := reconstitute F agg
def selfF : IsSelfConstituting F := selfConstitutes F agg

-- Scenario (refl candidates): 5 units go to identity 1, then 2 of them move
-- from identity 1 to identity 2.  The sum of the two masses stays 5.
def m1 : Measure := credit empty 1 5
def e1 : Le 2 (mass m1 1) := (3, reflNat 5)
def m2 : Measure := credit (debit m1 1 2 e1) 2 2
def massOne : EqNat (mass m2 1) 3 := reflNat 3
def massTwo : EqNat (mass m2 2) 2 := reflNat 2
def conserved : EqNat (natAdd (mass m2 1) (mass m2 2)) 5 := reflNat 5

-- Interest state (refl candidates, SPEC section 5 laws).  `restrict` gives
-- the restriction of each charter: `open` admits any amount, `restricted`
-- admits up to 4 units, `frozen` admits nothing.  Each identity is
-- domestic and retail.
def restrict : Charter -> Restriction := fun (c : Charter) (p : Profile) (r : Profile) =>
  match c as w in Charter return Cap with
  | open => any
  | restricted => upTo 4
  | frozen => deny
def prof : Profiles := fun (h : Identity) => tuple (domestic, retail)
def t0 : Treasury := tuple (fun (j : Kind) => 0, tuple (0, fun (h : Identity) => 0))
def s0 : InterestState := tuple (m1, tuple (restricted, t0))
def stateOr : InterestState -> Option InterestState -> InterestState :=
  fun (d : InterestState) (o : Option InterestState) =>
    case o with
    | 0 (u : prod ()) => d
    | 1 (t : InterestState) => t

-- transfer conserves the sum of the masses, and it moves 2 units.
def e2 : Le 2 (mass s0.0 1) := (3, reflNat 5)
def s1 : InterestState := stateOr s0 (transfer restrict prof 1 2 2 s0 e2)
def transferConserves : EqNat (natAdd (mass s1.0 1) (mass s1.0 2)) (natAdd (mass s0.0 1) (mass s0.0 2)) := reflNat 5
def transferMoves : EqNat (mass s1.0 2) 2 := reflNat 3
